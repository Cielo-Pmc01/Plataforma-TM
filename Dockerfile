# Node fijado a la versión con parche de seguridad (release 2026-10-21: CVE-2026-111497 y fallas TLS).
# Al salir nuevos parches, subir este tag.
FROM node:24.22.1-slim

WORKDIR /app

# Next.js incrusta las NEXT_PUBLIC_* en el bundle al hacer el build:
# deben llegar como build args (en Dokploy, con el mismo nombre que las variables de entorno).
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_CM_WEBHOOK_URL
ARG NEXT_PUBLIC_CM_CATALOG_WEBHOOK_URL
ARG NEXT_PUBLIC_CM_CHATWOOT_WEBHOOK_URL
ARG NEXT_PUBLIC_CM_TREND_WEBHOOK_URL
ARG NEXT_PUBLIC_N8N_META_ADS_URL
ARG NEXT_PUBLIC_N8N_META_ADS_REFRESH_URL
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL \
    NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY \
    NEXT_PUBLIC_CM_WEBHOOK_URL=$NEXT_PUBLIC_CM_WEBHOOK_URL \
    NEXT_PUBLIC_CM_CATALOG_WEBHOOK_URL=$NEXT_PUBLIC_CM_CATALOG_WEBHOOK_URL \
    NEXT_PUBLIC_CM_CHATWOOT_WEBHOOK_URL=$NEXT_PUBLIC_CM_CHATWOOT_WEBHOOK_URL \
    NEXT_PUBLIC_CM_TREND_WEBHOOK_URL=$NEXT_PUBLIC_CM_TREND_WEBHOOK_URL \
    NEXT_PUBLIC_N8N_META_ADS_URL=$NEXT_PUBLIC_N8N_META_ADS_URL \
    NEXT_PUBLIC_N8N_META_ADS_REFRESH_URL=$NEXT_PUBLIC_N8N_META_ADS_REFRESH_URL \
    NEXT_TELEMETRY_DISABLED=1 \
    CI=true

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

ENV NODE_ENV=production
EXPOSE 3000

CMD ["npm", "run", "start"]
